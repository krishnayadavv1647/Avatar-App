# ---------- core ----------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---------- data ----------
MONGO_URI=mongodb://localhost:27017/avatar_app
REDIS_URL=redis://localhost:6379

# ---------- auth ----------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- avatar provider ----------
# The default used when a create request does not name one.
#
# `mock` is a LOCAL STUB, not a vendor. It generates nothing: it waits ten
# seconds, then hands back the file you uploaded as the "avatar". It exists so
# a fresh clone runs with no accounts, and it is the only way a stub is ever
# selected - automatic selection skips stubs entirely.
#
# Leave this EMPTY once a real vendor is configured, or every avatar will be a
# stub no matter which vendors have keys.
#
# mock | lemonslice | (empty)
AVATAR_PROVIDER=mock

LEMONSLICE_API_KEY=

# Vendors are not assumed to sign webhooks, so the callback URL carries this
# token and the server rejects anything that does not match. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# Hard ceiling on a single call, in seconds.
MAX_CALL_SECONDS=3600

# ---------- transport ----------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker registration / dispatch target. Any value; must match on both sides.
AGENT_NAME=avatar-agent

# ---------- speech + language ----------
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=
# Used when ANTHROPIC_API_KEY is set (via the Anthropic plugin).
DEFAULT_LLM_MODEL=claude-sonnet-5
# Used when it is not. Must be a LiveKit Inference id ("provider/model") -
# Inference does not offer Claude.
FALLBACK_LLM_MODEL=google/gemma-4-31b-it

# LiveKit Inference speech models, in "provider/model" form.
# TTS_VOICE is required by Inference - a model alone is not enough.
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=en
TTS_MODEL=inworld/inworld-tts-2
TTS_VOICE=Ashley

# Voice cloning. With a key, people can upload or record their own voice in an
# avatar's settings; ElevenLabs clones it and avatars using it speak through
# ElevenLabs directly. Needs an ElevenLabs plan that includes Instant Voice
# Cloning. Leave empty to turn cloning off.
ELEVENLABS_API_KEY=
# eleven_flash_v2_5 is the low-latency model, the right one for live calls.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ---------- storage ----------
# local | r2
# `local` writes to ./uploads and serves them from this API. Those URLs are
# localhost, which avatar vendors cannot fetch - fine for the mock provider,
# not enough for vendors that fetch uploads themselves. Use `r2`, or expose PUBLIC_BASE_URL
# through a tunnel, before pointing a real vendor at an upload.
STORAGE_DRIVER=local

# Where this API is reachable from outside. The local driver builds upload URLs
# from it; set it to your tunnel host when testing a real vendor.
PUBLIC_BASE_URL=http://localhost:4000

# R2 (only needed when STORAGE_DRIVER=r2). The bucket must allow public reads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---------- billing ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=